# ==============================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# ==============================================
# Copy this file as .env and adjust values

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# JWT Settings
JWT_SECRET_KEY=super-secret-key-for-jwt-token-generation-minimum-32-characters-long-1234567890
JWT_ISSUER=MikroSaaS-IdentityService
JWT_AUDIENCE=MikroSaaS-Apps

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Application URLs
API_GATEWAY_URL=http://localhost:5000
IDENTITY_API_URL=http://localhost:5001
RESERVATION_API_URL=http://localhost:5002
NOTIFICATION_API_URL=http://localhost:5003
FRONTEND_URL=http://localhost:5173

# Test Account
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Test123!
