# ==============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==============================================
# Skopiuj ten plik jako .env.production i uzupełnij wartości

# Database
DB_USER=mikrosaas_user
DB_PASSWORD=CHANGE_THIS_SUPER_SECRET_PASSWORD
DB_HOST=postgres_db
DB_PORT=5432

# Connection strings
IDENTITY_DB_CONNECTION=Host=postgres_db;Port=5432;Database=identitydb;Username=mikrosaas_user;Password=CHANGE_THIS
RESERVATION_DB_CONNECTION=Host=postgres_db;Port=5432;Database=reservationdb;Username=mikrosaas_user;Password=CHANGE_THIS
NOTIFICATION_DB_CONNECTION=Host=postgres_db;Port=5432;Database=notificationdb;Username=mikrosaas_user;Password=CHANGE_THIS

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-minimum-32-characters-long-change-this-in-production
JWT_ISSUER=MikroSaaS-Production
JWT_AUDIENCE=MikroSaaS-Apps

# RabbitMQ
RABBITMQ_USER=mikrosaas_rabbit
RABBITMQ_PASSWORD=CHANGE_THIS_RABBIT_PASSWORD

# SSL Certificate
SSL_CERT_PASSWORD=your_ssl_cert_password

# SMTP Settings (dla wysyłania emaili)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Monitoring
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# Application URLs
APP_URL=https://your-domain.com
API_URL=https://api.your-domain.com

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Codziennie o 2:00 AM

# Resource Limits
MAX_UPLOAD_SIZE=10M
REQUEST_TIMEOUT=30s
MAX_CONNECTIONS=100
